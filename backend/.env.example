# Copy to backend/.env and adjust. Never commit the real .env.
ENVIRONMENT=development

# Local PostgreSQL (recommended for development; run `alembic upgrade head` first):
# DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/studyup_db
# Quick start without Postgres (tables are created automatically):
DATABASE_URL=sqlite:///./studyup.db
# Supabase (production) uses the pooled connection string, e.g.
# postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# local    -> FastAPI checks per-user password hashes and issues its own tokens
# supabase -> Supabase Auth issues tokens; FastAPI verifies them
AUTH_MODE=local
# Signs local access tokens. Use a long random value (32+ chars) outside development.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
TOKEN_TTL_MINUTES=720
# Password given to every demo account by `python -m app.seed` (development only).
DEMO_PASSWORD=demo1234

# Password recovery (AUTH_MODE=local). In development, reset links are printed to the API console.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
# Lifetime of set-password links sent by an admin (new-account invitations and admin-initiated resets).
INVITE_TTL_HOURS=72
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

SUPABASE_URL=
# Legacy HS256 JWT secret (Project Settings -> API). Leave empty to verify via JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# AI is optional and disabled by default. Every core feature works without it.
AI_FEATURES_ENABLED=false
# Server-side only. With AI enabled but no key, AI features return deterministic fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=600
AI_DAILY_LIMIT_PER_USER=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Question images (public, served at /uploads).
UPLOAD_DIR=uploads
# Memo attachments (only downloadable through the API after a permission check).
PRIVATE_UPLOAD_DIR=private_uploads

# Outgoing email for account invitations and password resets. Required in production for
# those emails to arrive. Without SMTP_HOST, development prints them to the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
