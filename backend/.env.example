# Copy to backend/.env and adjust.
ENVIRONMENT=development

# SQLite for local dev. For Supabase use the pooled connection string, e.g.
# postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./studyup.db
# Local Postgres (create the database first: CREATE DATABASE studyup;)
# DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/studyup

# demo     -> backend issues tokens for the seeded demo accounts (password below)
# supabase -> backend verifies Supabase Auth access tokens
AUTH_MODE=demo
APP_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
DEMO_PASSWORD=demo1234
TOKEN_TTL_MINUTES=720

SUPABASE_URL=
# Legacy HS256 JWT secret (Project Settings -> API). Leave empty to verify via JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Server-side only. Leave empty to use deterministic fallbacks for all AI features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=600
AI_DAILY_LIMIT_PER_USER=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
